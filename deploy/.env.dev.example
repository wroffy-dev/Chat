# Local development only. Copy to deploy/.env.dev (git-ignored) and fill in.
POSTGRES_PASSWORD=<local-dev-password>
# "<key>: <secret>" — secret at least 32 characters. Use the same values in backend/.env.
LIVEKIT_KEYS=devkey: <32-or-more-random-characters>
# Optional, for real phones on the same Wi-Fi: this computer's LAN address (e.g. 192.168.1.20).
# Leave empty for the emulator. See docs/PHONE_TEST_GUIDE.md.
DEV_LAN_IP=
