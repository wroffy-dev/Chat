# Copy to backend/.env for local development. Never commit .env.
# All values below are placeholders for a LOCAL development database only.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Runtime connection (least-privilege app role in production, see docs/13-database-design.md §1).
DATABASE_URL=postgresql://vaultchat:<local-dev-password>@localhost:5432/vaultchat
# Used only by `prisma migrate` (schema-owning role). Falls back to DATABASE_URL when unset.
# MIGRATE_DATABASE_URL=postgresql://vc_migrate:<password>@localhost:5432/vaultchat
DATABASE_POOL_MAX=10

# Comma-separated IPs/CIDRs of trusted reverse proxies. Leave empty locally.
# In production set this to the Traefik Docker network CIDR (verify in Coolify).
TRUST_PROXY=

BODY_LIMIT_BYTES=65536
SHUTDOWN_TIMEOUT_MS=10000
READINESS_DB_TIMEOUT_MS=2000
MIGRATIONS_DIR=prisma/migrations

# Integration tests only: a disposable database that tests may write to. Never a production URL.
# TEST_DATABASE_URL=postgresql://vaultchat:<local-dev-password>@localhost:5432/vaultchat_test
