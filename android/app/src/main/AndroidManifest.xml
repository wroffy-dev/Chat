<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Camera: used only on the Scan QR screen for now (and later for video calls). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Calls: microphone (all calls) and camera (video calls). Requested at the moment of use. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="true" />
    <!-- Incoming-call notifications (FCM wake-up) and keeping calls alive in the background. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Self-managed calls in Android's call framework (only used when the build enables it). -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <!-- In-app updates: hands the downloaded update to Android's installer (the user confirms). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- allowBackup=false and the extraction rules keep session tokens out of cloud and
         device-transfer backups (docs/04-accounts-and-authentication.md §4). -->
    <application
        android:name=".VaultChatApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.VaultChat">

        <!-- FCM must not start until the user signs in (docs/10-notifications.md §7). -->
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />

        <service
            android:name=".platform.push.VaultChatMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".platform.push.DeclineCallReceiver"
            android:exported="false" />

        <receiver
            android:name=".platform.update.UpdateInstallReceiver"
            android:exported="false" />

        <service
            android:name=".platform.call.CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
